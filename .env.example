# Supabase (Edge Functions + DB) — copy to .env.local and fill in
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-only secret (Vite /api/sync mirrors writes to Supabase). Never use VITE_ prefix.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional: override sync endpoint entirely
# VITE_SYNC_URL=
